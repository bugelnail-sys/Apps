# Optional. Werte als lokale Prozessvariablen setzen. Das Build-Skript liest keine .env-Datei.
# Anzeigename des Kodi-Hauptprofils
MOMENTUM_ADULT_A="Erwachsen A"
# Anzeigename des zweiten Erwachsenenprofils
MOMENTUM_ADULT_B="Erwachsen B"
# Anzeigename des Kinderprofils
MOMENTUM_KIDS="Kinder"
# Relative Verzeichnisnamen vorhandener Profile unter userdata/profiles.
# Ohne Vorgabe wird der jeweilige Anzeigename verwendet.
MOMENTUM_ADULT_B_DIR="Erwachsen B"
MOMENTUM_KIDS_DIR="Kinder"
